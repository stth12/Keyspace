{
  "name": "onlinekeygen",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "build": "npm run build -w @lk/api && npm run build -w @lk/web && npm run build -w @lk/desktop",
    "typecheck": "tsc --noEmit && npm run typecheck -w @lk/web",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration.test.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "setup:dev": "tsx scripts/setup-dev.ts",
    "admin": "tsx scripts/admin.ts",
    "dev:api": "tsx watch apps/api/src/main.ts",
    "dev:web": "npm run dev -w @lk/web",
    "worker": "tsx apps/worker/src/main.ts",
    "openapi": "tsx scripts/openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "^12.0.3",
    "@nestjs/core": "^12.0.3",
    "@nestjs/platform-express": "^12.0.3",
    "@nestjs/swagger": "^12.0.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@simplewebauthn/server": "14.0.2",
    "argon2": "^0.44.0",
    "canonicalize": "^2.1.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.0",
    "jose": "^6.1.0",
    "pg": "^8.16.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.0",
    "@types/node": "^24.10.0",
    "@types/pg": "^8.15.0",
    "@types/supertest": "^6.0.0",
    "prettier": "^3.9.8",
    "prisma": "7.10.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  },
  "overrides": {
    "mysql2": "3.24.4",
    "deepmerge-ts": "8.0.2"
  }
}
